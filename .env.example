# Backend v2 base URL. The browser never calls it directly: next.config.ts
# rewrites the API's root paths (/auth, /me, /providers, /results, ...) to it,
# so the session cookies and /me/stream stay same-origin.
#   Production: https://justgo.up.railway.app
#   Staging:    https://jgohealth-backend-staging.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://jgohealth-backend-staging.up.railway.app

# Optional: the media CDN host when the backend's CLOUDFLARE_PUBLIC_URL is a
# custom domain (r2.dev and signed R2 hosts are already allowed for next/image).
NEXT_PUBLIC_MEDIA_HOST=

# Patient app (just-go-health-patient). Optional; links into it are hidden when unset.
NEXT_PUBLIC_PATIENT_APP_URL=
